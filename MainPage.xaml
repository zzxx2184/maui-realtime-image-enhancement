<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:local="clr-namespace:lasthomework" 
             x:Class="lasthomework.MainPage"
             BackgroundColor="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="*, *" BackgroundColor="#222222">
            <Button x:Name="TabCameraButton" Grid.Column="0" Text="카메라 스캔" TextColor="White" BackgroundColor="#007AFF" Clicked="OnTabCameraClicked" />
            <Button x:Name="TabGalleryButton" Grid.Column="1" Text="갤러리 변환" TextColor="Gray" BackgroundColor="Transparent" Clicked="OnTabGalleryClicked" />
        </Grid>

        <Grid x:Name="CameraViewContainer" Grid.Row="1" Grid.RowSpan="2" IsVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:NativeCameraView x:Name="HardwareCamera" 
                                    Grid.Row="0"
                                    WidthRequest="1" HeightRequest="1" 
                                    HorizontalOptions="Start" VerticalOptions="Start"
                                    FrameReady="OnCameraFrameReady" />

            <skia:SKCanvasView x:Name="CameraCanvas" Grid.Row="0" PaintSurface="OnCameraCanvasPaintSurface" HorizontalOptions="Fill" VerticalOptions="Fill" />

            <Label x:Name="FpsLabel" Grid.Row="0" Text="FPS: --" TextColor="#00FF00" FontSize="14" FontAttributes="Bold" Margin="15" HorizontalOptions="Start" VerticalOptions="Start" />

            <StackLayout Grid.Row="1" Padding="20,10" BackgroundColor="#aa000000">
                <Label Text="스캔 강도 (실시간)" TextColor="White" FontSize="14" HorizontalOptions="Center" />
                <Slider x:Name="CameraIntensitySlider" Minimum="0.1" Maximum="8.0" Value="1.0" MinimumTrackColor="#007AFF" />
            </StackLayout>

            <Grid Grid.Row="2" ColumnDefinitions="*, Auto, *" Padding="20,15,20,30" BackgroundColor="#dd000000">
                <Button x:Name="AutoOptButton" Grid.Column="0" Text="⚡ 최적화: ON" BackgroundColor="#28A745" TextColor="White" HeightRequest="50" HorizontalOptions="Start" Clicked="OnAutoOptButtonClicked" />
                <Button Grid.Column="1" Text="📷 캡처" BackgroundColor="#007AFF" TextColor="White" FontAttributes="Bold" CornerRadius="35" HeightRequest="70" WidthRequest="70" Clicked="OnCaptureLiveClicked" />
            </Grid>
        </Grid>

        <Grid x:Name="GalleryViewContainer" Grid.Row="1" Grid.RowSpan="2" IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <skia:SKCanvasView x:Name="GalleryCanvas" Grid.Row="0" PaintSurface="OnGalleryCanvasPaintSurface" HorizontalOptions="Fill" VerticalOptions="Fill" />

            <StackLayout Grid.Row="1" Padding="20,10" BackgroundColor="#aa000000">
                <Label Text="스캔 강도 (사진)" TextColor="White" FontSize="14" HorizontalOptions="Center" />
                <Slider x:Name="GalleryIntensitySlider" Minimum="0.1" Maximum="8.0" Value="1.0" MinimumTrackColor="#6C757D" ValueChanged="OnGallerySliderValueChanged" />
            </StackLayout>

            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Padding="20,15,20,30" BackgroundColor="#dd000000">
                <Button Grid.Column="0" Text="📂 사진 불러오기" BackgroundColor="#6C757D" TextColor="White" HeightRequest="50" Margin="0,0,10,0" Clicked="OnLoadGalleryClicked" />
                <Button Grid.Column="1" Text="💾 저장하기" BackgroundColor="#007AFF" TextColor="White" HeightRequest="50" WidthRequest="120" Clicked="OnSaveGalleryClicked" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>